        "type": "string"
      },
      "EndpointCreate": {
        "additionalProperties": false,
        "properties": {
          "subscribed_event_types": {
            "examples": [
              [
                "order.created",
                "order.updated"
              ]
            ],
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Subscribed Event Types",
            "type": "array"
          },
          "url": {
            "examples": [
              "https://example.com/webhooks/relay"
            ],
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "subscribed_event_types"
        ],
        "title": "EndpointCreate",
        "type": "object"
      },
      "EndpointCreated": {
        "description": "Returned exactly once, at creation \u2014 the only time the HMAC signing secret is\never available. Never returned by a read/list endpoint.",
