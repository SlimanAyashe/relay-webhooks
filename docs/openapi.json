          "breaker_state": {
            "$ref": "#/components/schemas/BreakerState"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EndpointStatus"
          },
          "subscribed_event_types": {
