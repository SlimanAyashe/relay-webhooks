          "breaker_state": {
            "$ref": "#/components/schemas/BreakerState"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EndpointStatus"
          },
          "subscribed_event_types": {
            "items": {
              "type": "string"
            },
            "title": "Subscribed Event Types",
            "type": "array"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "subscribed_event_types",
          "status",
          "breaker_state",
          "created_at"
        ],
        "title": "EndpointRead",
        "type": "object"
