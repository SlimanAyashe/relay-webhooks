    "/v1/events": {
      "post": {
        "description": "Accepts an event for delivery to every endpoint subscribed to its type. Idempotency-Key is required: the same key with an identical body replays the original event (same 202, same event back); with a differing body it's a 409.",
        "operationId": "ingest_event_v1_events_post",
        "parameters": [
          {
            "description": "A client-generated key unique per logical event, for safe retries.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "description": "A client-generated key unique per logical event, for safe retries.",
              "examples": [
                "6c76a0e0-3b8e-4f8a-9b1a-2e6f9c9d2b7a"
              ],
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
