            },
            "title": "Subscribed Event Types",
            "type": "array"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "subscribed_event_types",
          "status",
          "breaker_state",
          "created_at",
          "secret"
        ],
        "title": "EndpointCreated",
        "type": "object"
      },
      "EndpointListResponse": {
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "items": {
