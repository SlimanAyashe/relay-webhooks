# Copy to .env and adjust for your environment. Never commit the real .env.

# Deployment environment label, surfaced in logs/health checks. One of: local, ci, staging, production.
ENV=local

# Log level for structlog/stdlib logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Async SQLAlchemy connection string (asyncpg driver). Points at the Postgres
# service started by docker-compose.yml for local dev.
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay

# Redis connection string used for streams, the retry ZSET, and pub/sub.
REDIS_URL=redis://localhost:6379/0

# Port the FastAPI app listens on inside its container.
API_PORT=8000

# Delivery engine (Phase 2) worker tuning -- defaults favor a fast demo feedback loop over
# production throughput; see docs/adr/0004-phase-2-delivery-engine.md.

# How often the relay worker polls the outbox table for pending rows when idle.
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# Max outbox rows the relay worker claims (via SKIP LOCKED) per poll.
OUTBOX_CLAIM_BATCH_SIZE=50

# Max delivery attempts the dispatcher worker runs concurrently.
DISPATCHER_CONCURRENCY=10

# How often the scheduler worker checks the retry ZSET for due deliveries.
SCHEDULER_TICK_INTERVAL_SECONDS=1.0

# How often the reaper worker sweeps for stale (crashed-consumer) pending stream entries.
REAPER_TICK_INTERVAL_SECONDS=30.0

# How long a stream entry must sit unacked before the reaper reclaims it.
REAPER_MIN_IDLE_MS=30000

# Phase 3 security & resilience tuning -- see docs/adr/0005-phase-3-security-resilience.md.
# The SSRF-guard deny list (loopback/RFC1918/link-local/CGNAT/IPv6 ULA/cloud metadata IP)
# is NOT configurable here on purpose -- it's fixed code in relay.infra.ssrf_guard, not
# something a deployer should be able to accidentally weaken via env var.

# How far a signed outbound request's timestamp may drift from "now" (either direction)
# and still verify -- bounds the replay window for X-Relay-Signature/X-Relay-Timestamp.
SIGNATURE_TOLERANCE_SECONDS=300

# Consecutive delivery-attempt failures before a per-endpoint circuit breaker opens.
BREAKER_FAILURE_THRESHOLD=5

# How long (seconds) an open breaker waits before allowing one half-open probe attempt.
BREAKER_COOLDOWN_SECONDS=60.0

# Destination ports the SSRF guard allows outbound delivery requests to target. JSON array.
SSRF_ALLOWED_PORTS=[80,443]

# Attempts (including the first) a delivery gets before it's given up on and moved to
# DeliveryState.DEAD -- the retry budget behind the dead-letter queue.
DELIVERY_MAX_ATTEMPTS=8

# Max concurrent in-flight delivery attempts against any single endpoint, regardless of
# overall dispatcher concurrency -- keeps one dead/slow destination from starving the pool.
DISPATCHER_PER_ENDPOINT_CONCURRENCY=3

# Per-tenant token-bucket rate limit on event ingest: steady-state requests/sec...
RATE_LIMIT_REQUESTS_PER_SECOND=5.0

# ...and the bucket's burst capacity (max requests admitted instantaneously).
RATE_LIMIT_BURST=20
